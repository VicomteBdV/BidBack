# Default deny: only the Next build inputs and three dependency-free guards enter.
**
!package.json
!package-lock.json
!next.config.ts
!next-env.d.ts
!tsconfig.json
!postcss.config.mjs
!tailwind.config.ts
!src/
!src/**
!public/
!public/**
!scripts/
scripts/**
!scripts/hosted-testnet-runtime.mjs
!scripts/validate-controlled-testnet-env.mjs
!scripts/deployment-json-validator.mjs

# Preserve public assets, but admit only the historical controlled-testnet manifest.
public/deployments/**
!public/deployments/84532.json

# Defense in depth for every allowed subtree, including symlinked dependencies.
**/.env
**/.env.*
**/*.env
**/*.env.*
**/*.key
**/*.pem
**/*.p12
**/*.pfx
**/*secret*
**/*credentials*
**/.npmrc
**/.netrc
**/.git
**/.git/**
**/.aws
**/.aws/**
**/node_modules
**/node_modules/**
**/.next
**/.next/**
**/cache
**/cache/**
**/coverage
**/coverage/**
**/test-results
**/test-results/**
**/playwright-report
**/playwright-report/**
**/__tests__
**/__tests__/**
**/*.test.*
**/*.spec.*
src/test/**
